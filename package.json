{
    "scripts": {
        "generate-manifest": "bun scripts/generate-manifest.mts",
        "install-browser": "bun scripts/install-browser.mts",
        "postinstall": "bun run install-browser",
        "build": "bun run generate-manifest && rollup -c && bun install --production --cwd com.hrk-m.kot-punch.sdPlugin",
        "logs": "tail -F \"$HOME/Library/Application Support/com.elgato.StreamDeck/Plugins/com.hrk-m.kot-punch.sdPlugin/logs/com.hrk-m.kot-punch.0.log\"",
        "lint": "oxlint src",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "type": "module",
    "devDependencies": {
        "@elgato/cli": "^1.7.1",
        "@rollup/plugin-commonjs": "^28.0.0",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^15.2.2",
        "@rollup/plugin-terser": "^0.4.4",
        "@rollup/plugin-typescript": "^12.1.0",
        "@tsconfig/node20": "^20.1.2",
        "@types/node": "~20.15.0",
        "@types/node-notifier": "^8.0.5",
        "@vitest/coverage-v8": "^3.0.0",
        "oxlint": "^0.16.0",
        "rollup": "^4.0.2",
        "tslib": "^2.6.2",
        "typescript": "^5.2.2",
        "vitest": "^3.0.0"
    },
    "dependencies": {
        "@elgato/streamdeck": "^2.0.0",
        "node-notifier": "^10.0.1",
        "puppeteer": "24.38.0"
    }
}
