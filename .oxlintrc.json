{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript"],
    "categories": {
        "correctness": "error",
        "suspicious": "warn",
        "perf": "warn"
    },
    "rules": {
        "no-console": "warn",
        "no-unused-vars": "off",
        "typescript/no-unused-vars": "error",
        "typescript/no-explicit-any": "warn",
        "typescript/no-non-null-assertion": "warn",
        "typescript/consistent-type-imports": "warn"
    },
    "env": {
        "node": true
    }
}
